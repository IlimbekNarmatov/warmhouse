@startuml
title DeviceIntegration - UseCases (Code Diagram)

package "application" {

    class RegisterDeviceUseCase {
        -repo: DeviceRepository
        +Execute(deviceData)
    }

    class GetDeviceStateUseCase {
        -gateway: DeviceGateway
        -repo: DeviceRepository
        +Execute(deviceId) : DeviceState
    }

    class GetDeviceUseCase {
        -repo: DeviceRepository
        +Execute(deviceId) : Device
    }

    class ExecuteDeviceCommandUseCase {
        -gateway: DeviceGateway
        -repo: DeviceRepository
        +Execute(deviceId, command) : DeviceState
    }

    class DeleteDeviceUseCase {
        - repo: DeviceRepository
        + Execute(deviceId)
    }
}

package "domain" {

    interface DeviceRepository {
        + findDevice(deviceId): Device
        + saveDevice(deviceData)
        + deleteDevice(deviceId)
    }

    interface DeviceGateway {
        + sendCommand(command, deviceId)
        + fetchState(deviceId): DeviceState
    }

    class Device {
        id: String
        name: String
        type: String
    }

    class DeviceState {
        deviceId: String
        status: String
        timestamp: DateTime
    }
}

GetDeviceUseCase --> DeviceRepository
RegisterDeviceUseCase --> DeviceRepository
GetDeviceStateUseCase --> DeviceGateway
ExecuteDeviceCommandUseCase --> DeviceGateway
GetDeviceStateUseCase --> DeviceRepository
ExecuteDeviceCommandUseCase --> DeviceRepository
DeleteDeviceUseCase --> DeviceRepository

GetDeviceUseCase --> Device
RegisterDeviceUseCase--> Device
GetDeviceStateUseCase --> DeviceState
ExecuteDeviceCommandUseCase --> DeviceState

@enduml
